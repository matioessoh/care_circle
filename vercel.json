{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python manage.py collectstatic --noinput && python manage.py migrate",
  "functions": {
    "care_circle/wsgi.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/rendez-vous/api/cron/reminders/",
      "schedule": "0 6 * * *"
    }
  ]
}